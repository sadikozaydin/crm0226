# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_ENABLED=false

# LibreTranslate Configuration
VITE_LIBRETRANSLATE_URL=/libretranslate
VITE_LIBRETRANSLATE_API_KEY=your_api_key_here_optional

# Google Translate (Backup)
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Supabase (if needed)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_ENABLED=false

# Webhook Security Keys
VITE_META_WEBHOOK_SECRET=your_meta_webhook_secret
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret

# Tenant Configuration
VITE_DEFAULT_TENANT_ID=tenant-001
# Other API Keys
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_AZURE_TRANSLATE_KEY=your_azure_translate_key_here